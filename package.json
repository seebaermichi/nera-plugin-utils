{
    "name": "@nera-static/plugin-utils",
    "version": "1.8.0",
    "description": "Shared helpers for Nera plugins and tools: config loading, template publishing, and subpath exports for values, logging, languages, dates, URLs and base_path, escaping, frontmatter, globs, package names and pages",
    "main": "index.js",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/seebaermichi/nera-plugin-utils.git"
    },
    "bugs": {
        "url": "https://github.com/seebaermichi/nera-plugin-utils/issues"
    },
    "homepage": "https://github.com/seebaermichi/nera-plugin-utils#readme",
    "keywords": [
        "nera",
        "static-site-generator",
        "plugin",
        "utils",
        "yaml",
        "templates"
    ],
    "author": "Michael Becker",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "js-yaml": "^5.2.2"
    },
    "devDependencies": {
        "eslint": "^10.8.0",
        "husky": "^9.1.7",
        "vitest": "^5.0.0",
        "yaml": "^2.4.1"
    },
    "scripts": {
        "test": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prepare": "husky"
    },
    "exports": {
        ".": "./index.js",
        "./values": "./src/values.js",
        "./log": "./src/log.js",
        "./config": "./src/config.js",
        "./packages": "./src/packages.js",
        "./guard": "./src/guard.js",
        "./html": "./src/html.js",
        "./lang": "./src/lang.js",
        "./dates": "./src/dates.js",
        "./sort": "./src/sort.js",
        "./urls": "./src/urls.js",
        "./frontmatter": "./src/frontmatter.js",
        "./glob": "./src/glob.js",
        "./pages": "./src/pages.js"
    },
    "files": [
        "index.js",
        "src",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=20.0.0"
    }
}
